{
    "name": "businessapi/au-identifiers-laravel",
    "description": "Laravel validation rules for Australian identifiers: ABN, ACN, ARBN, TFN, Director ID and VIN.",
    "keywords": ["laravel", "abn", "acn", "arbn", "tfn", "vin", "director-id", "australia", "validation", "validation-rule", "checksum", "ato", "asic"],
    "homepage": "https://businessapi.com.au",
    "license": "MIT",
    "authors": [{ "name": "Business API", "email": "dev@businessapi.com.au" }],
    "support": { "issues": "https://github.com/BusinessAPI/au-identifiers-laravel/issues", "source": "https://github.com/BusinessAPI/au-identifiers-laravel" },
    "require": {
        "php": "^8.2",
        "businessapi/au-identifiers": "^1.0",
        "illuminate/support": "^10.0 || ^11.0 || ^12.0",
        "illuminate/validation": "^10.0 || ^11.0 || ^12.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0 || ^10.0",
        "phpunit/phpunit": "^10.5 || ^11.0"
    },
    "autoload": { "psr-4": { "BusinessApi\\AuIdentifiers\\Laravel\\": "src/" } },
    "autoload-dev": { "psr-4": { "BusinessApi\\AuIdentifiers\\Laravel\\Tests\\": "tests/" } },
    "extra": {
        "laravel": {
            "providers": ["BusinessApi\\AuIdentifiers\\Laravel\\AuIdentifiersServiceProvider"]
        }
    },
    "scripts": { "test": "phpunit" },
    "config": { "sort-packages": true }
}
